      "struct": {
        "title": "Crystal structure of a macrocyclic beta-sheet peptide containing two beta-strands from amyloid beta residues 15-23"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
