      "struct": {
        "title": "X-ray crystallographic structure of a beta-hairpin peptide mimic derived from Abeta 16-36 ORN-LYS-LEU-VAL-H7V-PHE-ALA-GLU-ORN-ALA-ILE-ILE-GLY-LEU-MET-VAL"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
