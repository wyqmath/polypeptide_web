      "struct": {
        "title": "THREE-DIMENSIONAL STRUCTURE OF THE NEUROTOXIN ATX IA FROM ANEMONIA SULCATA IN AQUEOUS SOLUTION DETERMINED BY NUCLEAR MAGNETIC RESONANCE SPECTROSCOPY"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/prot.340060403"
      },
      "pubmed": {
