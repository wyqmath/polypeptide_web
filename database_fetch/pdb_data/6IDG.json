      "struct": {
        "title": "antibody 64M-5 Fab in complex with dT(6-4)T"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1107/S2053230X18017661"
