      "struct": {
        "title": "NMR ENSEMBLE OF ION-SELECTIVE LIGAND A22 FOR PLATELET INTEGRIN ALPHAIIB-BETA3"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M108071200"
