      "struct": {
        "title": "SOLUTION STRUCTURE OF PA1B, A 37-AMINO ACID INSECTICIDAL PROTEIN EXTRACTED FROM PEA SEEDS (PISUM SATIVUM)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
