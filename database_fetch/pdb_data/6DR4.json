      "struct": {
        "title": "X-ray crystallographic structure of a covalent trimer derived from A-beta 17_36 containing the I31V point mutation"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/jacs.8b06568"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
