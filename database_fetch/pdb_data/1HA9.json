      "struct": {
        "title": "SOLUTION STRUCTURE OF THE SQUASH TRYPSIN INHIBITOR MCoTI-II, NMR, 30 STRUCTURES."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
