      "struct": {
        "title": "High-resolution structure of ClpC1-NTD binding to Rufomycin-I"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acsinfecdis.8b00276"
