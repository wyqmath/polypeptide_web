      "struct": {
        "title": "SOLUTION STRUCTURE OF PAFP-S, AN ANTIFUNGAL PEPTIDE FROM THE SEEDS OF PHYTOLACCA AMERICANA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi010167k"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
