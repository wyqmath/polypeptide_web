      "struct": {
        "title": "ELUCIDATION OF THE PRIMARY AND THREE-DIMENSIONAL STRUCTURE OF THE UTEROTONIC POLYPEPTIDE KALATA B1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
