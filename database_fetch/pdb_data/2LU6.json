      "struct": {
        "title": "NMR solution structure of Midi peptide designed based on m-conotoxins"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M112.375733"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
