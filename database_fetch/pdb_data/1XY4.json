      "struct": {
        "title": "NMR strcutre of sst1-selective somatostatin (SRIF) analog 1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/jm049518u"
