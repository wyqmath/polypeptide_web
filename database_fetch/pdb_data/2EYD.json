      "struct": {
        "title": "Water refined solution structure of crambin in dpc micelles"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/ja057773d"
