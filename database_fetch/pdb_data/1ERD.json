      "struct": {
        "title": "THE NMR SOLUTION STRUCTURE OF THE PHEROMONE ER-2 FROM THE CILIATED PROTOZOAN EUPLOTES RAIKOVI"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
