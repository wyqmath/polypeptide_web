      "struct": {
        "title": "Lybatide 2, a cystine-rich peptide from Lycium barbarum"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41598-017-05037-1"
