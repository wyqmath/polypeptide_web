      "struct": {
        "title": "The NMR solution structure of the peptide AC12 from Hypsiboas raniceps"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.peptides.2018.12.007"
