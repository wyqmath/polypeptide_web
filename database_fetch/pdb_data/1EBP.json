      "struct": {
        "title": "COMPLEX BETWEEN THE EXTRACELLULAR DOMAIN OF ERYTHROPOIETIN (EPO) RECEPTOR [EBP] AND AN AGONIST PEPTIDE [EMP1]"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
