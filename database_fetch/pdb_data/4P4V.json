      "struct": {
        "title": "Hexamer formed by a macrocyclic peptide derived from beta-2-microglobulin (63-69) - (ORN)YLL(PHI)YTE(ORN)KVA(MAA)AVK"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/jacs.5b01673"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
