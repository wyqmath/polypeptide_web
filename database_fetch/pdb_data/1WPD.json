      "struct": {
        "title": "Evidence for domain-specific recognition of SK and Kv channels by MTX and HsTx1 scorpion toxins"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M410055200"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
