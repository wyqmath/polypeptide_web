      "struct": {
        "title": "Structure of the antimicrobial hexapeptide cyc-(RRWWRF) bound to SDS micelles"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/cbic.200500095"
