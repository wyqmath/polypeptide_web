      "struct": {
        "title": "3D STRUCTURE OF K-CONOTOXIN PVIIA, A NOVEL POTASSIUM CHANNEL-BLOCKING TOXIN FROM CONE SNAILS, NMR, 22 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
