      "struct": {
        "title": "CORRELATED DISORDER OF THE PURE PRO22(SLASH)LEU25 FORM OF CRAMBIN AT 150K REFINED TO 1.05 ANGSTROMS RESOLUTION"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
