      "struct": {
        "title": "Solution structure of human insulin-like peptide 5 (INSL5)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1042/BJ20082353"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
