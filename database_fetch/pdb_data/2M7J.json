      "struct": {
        "title": "Solution Structure of a Beta-Hairpin Peptidomimetic antibiotic that target LptD in Pseudomonas sp."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
