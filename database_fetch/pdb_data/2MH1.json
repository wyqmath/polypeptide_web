      "struct": {
        "title": "Enzymatic cyclisation of kalata B1 using sortase A"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M113.539262"
