      "struct": {
        "title": "Cryo-electron microscopy structure of Neisseria gonorrhoeae multidrug efflux pump MtrD with CASP peptide complex"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
