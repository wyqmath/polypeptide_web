      "struct": {
        "title": "Solution structure of the Family 1 carbohydrate-binding module with glucosylated Ser3"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acs.biochem.7b00195"
