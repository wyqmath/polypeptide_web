      "struct": {
        "title": "Solution structure and alanine scan of a spider toxin that affects the activation of mammalian sodium channels"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M605403200"
