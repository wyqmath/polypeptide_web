      "struct": {
        "title": "NMR SOLUTION CONFORMATION OF AN ANTITOXIC ANALOG OF ALPHA-CONOTOXIN GI"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
