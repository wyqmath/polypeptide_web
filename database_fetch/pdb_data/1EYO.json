      "struct": {
        "title": "SOLUTION STRUCTURE OF CONOTOXIN TVIIA FROM CONUS TULIPA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1046/j.1432-1327.2000.01507.x"
