      "struct": {
        "title": "RSV G central conserved region bound to Fab CB017.5"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1371/journal.ppat.1006935"
