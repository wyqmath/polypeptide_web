      "struct": {
        "title": "RTD-1, A CYCLIC ANTIMICROBIAL DEFENSIN FROM RHESUS MACAQUE LEUKOCYTES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
