      "struct": {
        "title": "1.95A resolution structure of independent phosphoglycerate mutase from S. aureus in complex with a macrocyclic peptide inhibitor (Sa-D3)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
