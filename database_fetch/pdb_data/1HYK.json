      "struct": {
        "title": "AGOUTI-RELATED PROTEIN (87-132) (AC-AGRP(87-132))"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/S0014-5793(99)00553-0"
