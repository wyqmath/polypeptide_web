      "struct": {
        "title": "Solution Structure of a Novel C2 Symmetrical Bifunctional Bicyclic Inhibitor Based on SFTI-1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1007/S10858-005-1210-9"
