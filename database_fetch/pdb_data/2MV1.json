      "struct": {
        "title": "Solution NMR structure of Human Relaxin-2"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/cb500918v"
