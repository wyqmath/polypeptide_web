      "struct": {
        "title": "Nicomicin-1 -- Novel antimicrobial peptides from the Arctic polychaeta Nicomache minor provide new molecular insight into biological role of the BRICHOS domain"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.3390/md16110401"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
