      "struct": {
        "title": "Racemic structure of ribifolin, an orbitide from Jatropha ribifolia"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acs.jnatprod.8b00447"
