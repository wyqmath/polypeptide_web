      "struct": {
        "title": "THE SOLUTION STRUCTURE OF THE B-FORM OF UROGUANYLIN-16 NMR, 10 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
