      "struct": {
        "title": "SEA ANEMONE TOXIN (BGK) WITH HIGH AFFINITY FOR VOLTAGE DEPENDENT POTASSIUM CHANNEL, NMR, 15 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
