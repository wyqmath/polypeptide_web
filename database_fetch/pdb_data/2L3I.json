      "struct": {
        "title": "Oxki4a, spider derived antimicrobial peptide"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1111/j.1742-4658.2011.08361.x"
