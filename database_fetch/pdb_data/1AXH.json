      "struct": {
        "title": "ATRACOTOXIN-HVI FROM HADRONYCHE VERSUTA (AUSTRALIAN FUNNEL-WEB SPIDER, NMR, 20 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/nsb0797-559"
