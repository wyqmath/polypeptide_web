      "struct": {
        "title": "SOLUTION STRUCTURE OF THE INSECTICIDAL NEUROTOXIN J-ATRACOTOXIN-HV1C"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
