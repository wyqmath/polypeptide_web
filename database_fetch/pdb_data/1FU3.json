      "struct": {
        "title": "THREE-DIMENSIONAL STRUCTURE IN SOLUTION OF THE SODIUM CHANNEL AGONIST/ANTAGONIST DELTA-CONOTOXIN TXVIA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M206833200"
