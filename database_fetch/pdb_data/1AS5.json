      "struct": {
        "title": "SOLUTION STRUCTURE OF CONOTOXIN Y-PIIIE FROM CONUS PURPURASCENS, NMR, 14 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi972186t"
