      "struct": {
        "title": "STRUCTURE OF THE RGD PROTEIN DECORSIN: CONSERVED MOTIF AND DISTINCT FUNCTION IN LEECH PROTEINS THAT AFFECT BLOOD CLOTTING"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
