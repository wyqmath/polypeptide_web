      "struct": {
        "title": "Structure of the 093G9 Fab in complex with the epitope peptide"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/jmr.2645"
