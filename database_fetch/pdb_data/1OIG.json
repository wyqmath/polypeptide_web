      "struct": {
        "title": "The solution structure of the DPY module from the Dumpy protein"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/S0960-9822(00)00482-6"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
