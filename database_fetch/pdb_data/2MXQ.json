      "struct": {
        "title": "The solution structure of DEFA1, a highly potent antimicrobial peptide from the horse"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.bbrc.2015.02.168"
