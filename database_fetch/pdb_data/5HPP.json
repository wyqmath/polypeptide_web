      "struct": {
        "title": "Crystal structure of a macrocyclic beta-sheet peptide derived from transthyretin (106-121) - (ORN)TIA(MAA)LLS(ORN)S(PHI)STTAV"
      },
      "rcsb_ma_qa_metric_global": null,
