      "struct": {
        "title": "Identification of the Structural Traits Mediating the Antimicrobial Activity of a Chimeric Peptide of HBD2 and HBD3"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.bbrc.2012.09.052"
