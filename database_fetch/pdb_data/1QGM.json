      "struct": {
        "title": "THE SOLUTION STRUCTURE OF A 30 RESIDUE AMINO-TERMINAL DOMAIN OF THE CARP GRANULIN-1 PROTEIN."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
