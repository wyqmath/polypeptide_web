      "struct": {
        "title": "NMR SOLUTION STRUCTURE OF ALPHA-CONOTOXIN GID MUTANT A10V"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1073/pnas.1703952114"
