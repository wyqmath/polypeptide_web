      "struct": {
        "title": "NMR solution structure of Pisum sativum defensin 2 (Psd2) provides evidence for the presence of hydrophobic surface clusters"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
