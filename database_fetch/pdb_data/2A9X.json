      "struct": {
        "title": "TAR RNA recognition by a cyclic peptidomimetic of Tat protein"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi0510532"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
