      "struct": {
        "title": "Solution Structure of Human beta-Defensin 3"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M108830200"
