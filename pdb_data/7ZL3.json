      "struct": {
        "title": "Signal peptide mimicry primes Sec61 for client-selective inhibition"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41589-023-01326-1"
