      "struct": {
        "title": "De novo protein design enables the precise induction of RSV-neutralizing antibodies"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1126/science.aay5051"
