      "struct": {
        "title": "Cyclic pentapeptide which inhibits Hantavirus"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1111/j.1747-0285.2007.00489.x"
