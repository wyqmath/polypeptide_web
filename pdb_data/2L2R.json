      "struct": {
        "title": "Helical hairpin structure of a novel antimicrobial peptide EcAMP1 from seeds of barnyard grass (Echinochloa crus-galli)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
