      "struct": {
        "title": "Cryo-EM structure of the BcsB hexameric crown from the E. coli cellulose secretion macrocomplex"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41467-024-53113-8"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 39394223
