      "struct": {
        "title": "NMR STRUCTURE OF HUMAN BETACELLULIN-2"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/S0006-291X(02)00585-5"
