      "struct": {
        "title": "crystal structure of cA4-activated Card1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41586-021-03206-x"
