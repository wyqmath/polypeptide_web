      "struct": {
        "title": "Solution structure of a Novel Alpha-Conotoxin TxIB"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M112.427898"
