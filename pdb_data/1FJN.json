      "struct": {
        "title": "SOLUTION STRUCTURE AND ACTIVITY OF THE FOUR DISULFIDE BOND MEDITERRANEAN MUSSEL DEFENSIN MGD-1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
