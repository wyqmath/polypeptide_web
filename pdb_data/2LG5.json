      "struct": {
        "title": "NMR structure of Chicken AvBD2 defensin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M111.312108"
