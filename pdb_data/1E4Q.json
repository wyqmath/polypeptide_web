      "struct": {
        "title": "Solution structure of the human defensin hBD-2"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1110/PS.PS.24401"
