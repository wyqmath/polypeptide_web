      "struct": {
        "title": "SOLUTION STRUCTURE OF A TOXIN FROM THE TARANTULA, GRAMMOSTOLA SPATULATA, WHICH INHIBITS MECHANOSENSITIVE ION CHANNELS"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M202715200"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
