      "struct": {
        "title": "Solution NMR structure of 8-residue Rosetta-designed cyclic peptide D8.21 in 50% d6-DMSO and 50% water with cis/trans switching (CC conformation, 50%)"
      },
      "rcsb_ma_qa_metric_global": null,
