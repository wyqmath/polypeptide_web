      "struct": {
        "title": "Connecting hydrophobic surfaces in cyclic peptides increases membrane permeability"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/anie.202012643"
