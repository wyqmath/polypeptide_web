      "struct": {
        "title": "Solution Structure of A New Potassium Channels Blocker from the Venom of Chinese Scorpion Buthus martensi Karsch"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/prot.20322"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
