      "struct": {
        "title": "Crystal structure of the HIV-1 Cross Neutralizing Monoclonal Antibody 2F5 in complex with gp41 Peptide ECDKWCS"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1128/JVI.01604-09"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 19740978
