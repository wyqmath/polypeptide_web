      "struct": {
        "title": "Pharmacological characterisation and NMR structure of the novel mu-conotoxin SxIIIC, a potent irreversible NaV channel inhibitor"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
