      "struct": {
        "title": "Crystal structure of Chorismate Mutase from Mycobacterium tuberculosis in complex with the cyclic peptide inhibitor D1.3"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
