      "struct": {
        "title": "THE THREE-DIMENSIONAL SOLUTION STRUCTURE OF THE RABBIT KIDNEY DEFENSIN, RK-1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi000457l"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
