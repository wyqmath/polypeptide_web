      "struct": {
        "title": "Solution NMR structure of the nodule-specific cysteine-rich peptide NCR044 from Medicago truncatula"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1073/pnas.2003526117"
