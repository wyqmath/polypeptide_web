      "struct": {
        "title": "Hev b 6.02 (hevein) extracted from surgical gloves"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.molimm.2015.01.018"
