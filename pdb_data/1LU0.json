      "struct": {
        "title": "Atomic Resolution Structure of Squash Trypsin Inhibitor: Unexpected Metal Coordination"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1107/S0907444902011769"
