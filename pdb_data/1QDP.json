      "struct": {
        "title": "SOLUTION STRUCTURE OF ROBUSTOXIN, THE LETHAL NEUROTOXIN FROM THE FUNNEL WEB SPIDER ATRAX ROBUSTUS, NMR, 20 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/S0014-5793(97)01452-X"
