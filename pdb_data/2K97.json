      "struct": {
        "title": "Dimeric solution structure of the cyclic octamer d(pCGCTCCGT)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1093/nar/gkp191"
