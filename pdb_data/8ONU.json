      "struct": {
        "title": "Solution structure of thanatin analogue 7 in complex with LptAm(Ab)1.0"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.3390/molecules28114335"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
