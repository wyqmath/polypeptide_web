      "struct": {
        "title": "NMR structure of the glycosylated conotoxin CcTx from Conus consors"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/CHEM.201202713"
