      "struct": {
        "title": "Spatial structure of Hm-3, a membrane-active spider toxin affecting sodium channels"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M114.595678"
