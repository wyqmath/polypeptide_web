      "struct": {
        "title": "Structure-Activity Relationships and Biological Characterization of a Novel, Potent and Serum Stable C-X-C chemokine receptor type 4 (CXCR4) Antagonist"
      },
      "rcsb_ma_qa_metric_global": null,
