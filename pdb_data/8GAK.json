      "struct": {
        "title": "Crystal Structure of E. coli LptA in complex with Chinavia Ubica Thanatin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.yjsbx.2023.100091"
