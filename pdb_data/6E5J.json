      "struct": {
        "title": "Heterogeneous-Backbone Mimics of a Designed Disulfide-Rich Protein: Aib turn, beta3 helix, N-methyl hairpin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
