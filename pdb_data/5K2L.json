      "struct": {
        "title": "Crystal structure of LysM domain from Volvox carteri chitinase"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1007/s11103-016-0549-5"
