      "struct": {
        "title": "Solution structure of the Sex Peptide from Drosophila melanogaster"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.febslet.2011.03.040"
