      "struct": {
        "title": "The high resolution structure of tyrocidine A reveals an amphipathic dimer"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.bbamem.2014.01.033"
