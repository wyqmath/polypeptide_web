      "struct": {
        "title": "Crystal structure of the single chain variable fragment of the DH270.6 bnAb in complex with the Man9-V3 glycopeptide"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41467-018-03565-6"
