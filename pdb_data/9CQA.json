      "struct": {
        "title": "Structure of antibody 1G1 bound to the central conserved region of RSV G"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41598-025-92886-w"
