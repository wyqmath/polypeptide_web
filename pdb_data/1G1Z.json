      "struct": {
        "title": "NMR Solution Structures of delta-Conotoxin EVIA from Conus ermineus that Selectively Acts on Vertebrate Neuronal Na+ Channels, LEU12-PRO13 Cis isomer"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M309594200"
