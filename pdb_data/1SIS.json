      "struct": {
        "title": "SPATIAL STRUCTURE OF INSECTOTOXIN I5A BUTHUS EUPEUS BY 1H NUCLEAR MAGNETIC RESONANCE SPECTROSCOPY (RUSSIAN)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": null
      },
      "pubmed": {
