      "struct": {
        "title": "Interactions of quinoxaline antibiotic and DNA: the molecular structure of a TRIOSTIN A-D(GCGTACGC) complex"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
