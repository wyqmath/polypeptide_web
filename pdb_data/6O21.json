      "struct": {
        "title": "Crystal Structure of Human KLK4 in Complex With Cleaved SFTI-FCQR(Asn14)[1,14] Inhibitor"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
