      "struct": {
        "title": "NMR structures of transmembrane segment from subunit a from the yeast proton V-ATPase"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.bbamem.2007.05.014"
