      "struct": {
        "title": "EngBF DARPin Fusion 4b G10"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41598-019-51017-y"
