      "struct": {
        "title": "Pholiota squarrosa lectin (PhoSL) in complex with fucose(alpha1-6)[GlcNAc(beta1-4)]GlcNAc"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1111/febs.16599"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
