      "struct": {
        "title": "Cobatoxin 1 from Centruroides noxius Scorpion venom: Chemical Synthesis, 3-D Structure in Solution, Pharmacology and Docking on K+ channels"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1042/BJ20030977"
