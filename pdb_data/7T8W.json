      "struct": {
        "title": "Structure of antibody 3G12 bound to Respiratory Syncytial Virus G central conserved domain mutant S177Q"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
