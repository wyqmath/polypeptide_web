      "struct": {
        "title": "SOLUTION STRUCTURE OF NEUROTOXIN I FROM THE SEA ANEMONE STICHODACTYLA HELIANTHUS. A NUCLEAR MAGNETIC RESONANCE, DISTANCE GEOMETRY AND RESTRAINED MOLECULAR DYNAMICS STUDY"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
