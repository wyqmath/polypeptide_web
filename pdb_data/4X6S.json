      "struct": {
        "title": "Grb7 SH2 domain with phosphotyrosine mimetic inhibitor peptide"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acs.jmedchem.5b00609"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
