      "struct": {
        "title": "Bifunctional dendrimers"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1039/c5sc03635f"
