      "struct": {
        "title": "THREE-DIMENSIONAL SOLUTION STRUCTURE OF ALPHA-CONOTOXIN GID BY NMR SPECTROSCOPY"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M210280200"
