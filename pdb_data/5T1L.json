      "struct": {
        "title": "Cetuximab Fab in complex with CQA(Ph)2DLSTRRLKC peptide"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1107/S2053230X16016149"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
