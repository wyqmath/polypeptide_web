      "struct": {
        "title": "Co-crystal structure of Ac-AChBPP in complex with alpha-conotoxin LvIA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1007/s13238-017-0426-2"
