      "struct": {
        "title": "NMR STUDY OF BROMELAIN INHIBITOR VI FROM PINEAPPLE STEM"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi952754+"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
