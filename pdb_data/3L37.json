      "struct": {
        "title": "PIE12 D-peptide against HIV entry"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1128/JVI.01339-10"
