      "struct": {
        "title": "Crystal Structure of the dust mite allergen Der p 23 from Dermatophagoides pteronyssinus"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
