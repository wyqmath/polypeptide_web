      "struct": {
        "title": "EFFECTS OF GLYCOSYLATION ON THE STRUCTURE AND DYNAMICS OF EEL CALCITONIN, NMR, 10 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi983018j"
