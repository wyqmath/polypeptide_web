      "struct": {
        "title": "Nmr structure of hen egg beta-defensin gallin (chicken ovo-defensin)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M113.507046"
