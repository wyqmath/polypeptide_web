      "struct": {
        "title": "X-ray crystallographic structure of a beta-hairpin peptide mimic derived from Abeta 16-36. Rigaku data set. (ORN)KLV(MEA)FAE(ORN)AIIGLMV."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acs.biochem.7b00831"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
