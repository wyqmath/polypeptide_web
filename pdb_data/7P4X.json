      "struct": {
        "title": "SOLUTION NMR STRUCTURE OF PALUSTRIN-CA IN 50% TRIFLUOROETHANOL"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41598-021-01769-3"
