      "struct": {
        "title": "DETERMINATION OF THE THREE-DIMENSIONAL STRUCTURE OF SCYLLATOXIN BY 1H NUCLEAR MAGNETIC RESONANCE"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1006/jmbi.1995.0575"
