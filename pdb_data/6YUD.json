      "struct": {
        "title": "Structure of Csx3/Crn3 from Archaeoglobus fulgidus in complex with cyclic tetra-adenylate (cA4)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
