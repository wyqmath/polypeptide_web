      "struct": {
        "title": "NMR STRUCTURE OF THE ALPHA-HELICAL HAIRPIN OF P8MTCP1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": null
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 10850804
