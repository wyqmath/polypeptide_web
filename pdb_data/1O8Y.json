      "struct": {
        "title": "Solution structure of SFTI-1(6,5), an acyclic permutant of the proteinase inhibitor SFTI-1, trans-trans-trans conformer (tt-A)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
