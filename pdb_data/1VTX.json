      "struct": {
        "title": "DELTA-ATRACOTOXIN-HV1 (VERSUTOXIN) FROM HADRONYCHE VERSUTA, NMR, 20 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
