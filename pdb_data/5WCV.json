      "struct": {
        "title": "AsK132958: A minimal homologue of ShK identified in the transcriptome of Anemonia sulcata"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.peptides.2017.10.001"
