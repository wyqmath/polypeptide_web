      "struct": {
        "title": "Crystal structure of an insect inhibitor with a fungal trypsin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1107/S0907444908030400"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
