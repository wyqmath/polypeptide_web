      "struct": {
        "title": "Solution structure of the all-D kalata B1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/cbic.201100450"
