      "struct": {
        "title": "Exploring Cystine Dense Peptide Space to Open a Unique Molecular Toolbox"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41594-018-0033-9"
