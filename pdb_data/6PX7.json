      "struct": {
        "title": "Dg12a in Weaponisation 'on the fly': Convergent recruitment of knottin and defensin scaffolds as neurotoxins in the venom of assassin fly Dolopus genitalis (Diptera: Asilidae)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.ibmb.2019.103310"
