      "struct": {
        "title": "THE SOLUTION STRUCTURE OF OMEGA-AGA-IVB, A P-TYPE CALCIUM CHANNEL ANTAGONIST FROM THE VENOM OF AGELENOPSIS APERTA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1007/BF00208803"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
