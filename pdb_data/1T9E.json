      "struct": {
        "title": "NMR solution structure of a disulfide analogue of the cyclic sunflower trypsin inhibitor SFTI-1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi048297r"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
