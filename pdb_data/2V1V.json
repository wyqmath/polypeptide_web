      "struct": {
        "title": "3D STRUCTURE OF THE M8L MUTANT OF SQUASH TRYPSIN INHIBITOR CMTI-I"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1110/ps.9.2.273"
