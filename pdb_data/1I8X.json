      "struct": {
        "title": "SEMI-AUTOMATIC STRUCTURE DETERMINATION OF THE CG1 1-30 PEPTIDE BASED ON ARIA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/prot.10077.abs"
