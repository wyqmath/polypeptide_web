      "struct": {
        "title": "HIGH RESOLUTION 1H NMR STUDY OF LEUCOCIN A IN 90% AQUEOUS TRIFLUOROETHANOL (TFE) (0.1% TFA), 18 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi971263h"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
