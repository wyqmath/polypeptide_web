      "struct": {
        "title": "E. coli BamA beta-barrel bound to darobactin and cyclic peptide CP1"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41467-025-58086-w"
