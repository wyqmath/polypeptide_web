      "struct": {
        "title": "SOLUTION STRUCTURE OF THE MAIN ALPHA-AMYLASE INHIBITOR FROM AMARANTH SEEDS"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1046/j.1432-1327.2001.02118.x"
