      "struct": {
        "title": "ALPHA CONOTOXIN GI: 2-13;3-7 DISULFIDE BOND ISOMER NMR, 24 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
