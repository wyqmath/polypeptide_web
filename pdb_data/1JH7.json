      "struct": {
        "title": "Semi-reduced Inhibitor-bound Cyclic Nucleotide Phosphodiesterase from Arabidopsis thaliana"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M107889200"
