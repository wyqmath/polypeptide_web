      "struct": {
        "title": "THE MOLECULAR STRUCTURE OF A DNA-TRIOSTIN A COMPLEX"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
