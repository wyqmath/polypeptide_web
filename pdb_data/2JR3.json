      "struct": {
        "title": "Antibacterial Peptide from Eggshell Matrix: Structure and Self-assembly of beta-defensin Like Peptide from the Chinese Soft-shelled Turtle Eggshell"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/ja075659k"
