      "struct": {
        "title": "THREE-DIMENSIONAL SOLUTION STRUCTURE OF OMEGA-CONOTOXIN TXVII, AN L-TYPE CALCIUM CHANNEL BLOCKER"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
