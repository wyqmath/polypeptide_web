      "struct": {
        "title": "Complex of a chitinase with the natural product cyclopentapeptide argadin from Clonostachys"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1073/PNAS.132060599"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
