      "struct": {
        "title": "Structural and functional characterisation of Tst2, a novel TRPV1 inhibitory peptide from the Australian sea anemone Telmatactis stephensoni"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
