      "struct": {
        "title": "Crystal Structure of a Single-Domain Cyclophilin from Brassica napus Phloem Sap"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41598-019-45856-y"
