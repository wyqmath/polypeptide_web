      "struct": {
        "title": "Plant peptide hormone regulating stomatal density"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/ncomms1520"
