      "struct": {
        "title": "NMR structure of the sea anemone peptide tau-AnmTx Ueq 12-1 with an uncommon fold"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
