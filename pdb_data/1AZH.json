      "struct": {
        "title": "THREE-DIMENSIONAL STRUCTURES OF THREE ENGINEERED CELLULOSE-BINDING DOMAINS OF CELLOBIOHYDROLASE I FROM TRICHODERMA REESEI, NMR, 14 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
