      "struct": {
        "title": "Solution Structure of BmKK4, A Novel Potassium Channel Blocker from Scorpion Buthus martensii Karsch, 25 structures"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
