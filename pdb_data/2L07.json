      "struct": {
        "title": "1H, 13C, and 15N chemical shifts and structure of brazzein-derived peptide CKR-PNG"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1093/chemse/bjr057"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
