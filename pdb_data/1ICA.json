      "struct": {
        "title": "REFINED THREE-DIMENSIONAL STRUCTURE OF INSECT DEFENSIN A"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/S0969-2126(01)00177-0"
