      "struct": {
        "title": "THE 1.2 ANGSTROM STRUCTURE OF G1 ALPHA CONOTOXIN"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi960820h"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
