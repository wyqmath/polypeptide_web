      "struct": {
        "title": "MINIMAL CONFORMATION OF THE ALPHA-CONOTOXIN IMI FOR THE ALPHA7 NEURONAL NICOTINIC ACETYLCHOLINE RECEPTOR RECOGNITION"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/S0014-5793(99)00831-5"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
