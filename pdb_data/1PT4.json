      "struct": {
        "title": "Solution structure of the Moebius cyclotide kalata B2"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi047837h"
