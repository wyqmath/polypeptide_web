      "struct": {
        "title": "NMR structure of Protegrin-3 (PG3) in the presence of DPC micelles"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1007/s10858-015-9920-0"
