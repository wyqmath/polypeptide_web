      "struct": {
        "title": "SCORPION TOXIN BMTX1 FROM BUTHUS MARTENSII KARSCH, NMR, 25 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
