      "struct": {
        "title": "64M-2 ANTIBODY FAB COMPLEXED WITH D(5HT)(6-4)T"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1006/jmbi.2000.3772"
