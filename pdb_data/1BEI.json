      "struct": {
        "title": "Shk-dnp22: A Potent Kv1.3-specific immunosuppressive polypeptide, NMR, 20 structures"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.273.49.32697"
