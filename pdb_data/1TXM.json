      "struct": {
        "title": "SCORPION TOXIN (MAUROTOXIN) FROM SCORPIO MAURUS, NMR, 35 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1002/(SICI)1097-0134(199711)29:3<321::AID-PROT6>3.3.CO;2-K"
