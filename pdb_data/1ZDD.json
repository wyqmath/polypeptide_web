      "struct": {
        "title": "DISULFIDE-STABILIZED MINI PROTEIN A DOMAIN, Z34C, NMR, MINIMIZED MEAN STRUCTURE"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
