      "struct": {
        "title": "Simultaneous recognition of HIV-1 TAR RNA bulge and loop sequences by cyclic peptide mimic of Tat protein"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1073/pnas.0900629106"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
