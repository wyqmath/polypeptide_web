      "struct": {
        "title": "Structure of Viscotoxin A3 from Viscum Album in the complex with DPC micelles"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.bbrc.2021.11.022"
