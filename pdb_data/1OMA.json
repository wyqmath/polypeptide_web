      "struct": {
        "title": "SEQUENTIAL ASSIGNMENT AND STRUCTURE DETERMINATION OF SPIDER TOXIN OMEGA-AGA-IVB"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi00211a022"
