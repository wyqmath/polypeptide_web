      "struct": {
        "title": "Structure of ToPI1 inhibitor from Tityus obscurus scorpion venom in complex with trypsin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acs.jmedchem.0c00686"
