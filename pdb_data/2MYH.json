      "struct": {
        "title": "Omega-Tbo-IT1: selective inhibitor of insect calcium channels isolated from Tibellus oblongus spider venom"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/srep17232"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
