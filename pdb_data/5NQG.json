      "struct": {
        "title": "Crystal structure of Plasmodium vivax AMA1 in complex with a 39 aa PvRON2 peptide"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1371/journal.pone.0183198"
