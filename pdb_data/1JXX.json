      "struct": {
        "title": "CRAMBIN MIXED SEQUENCE FORM AT 200 K. PROTEIN/WATER SUBSTATES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1073/pnas.201404398"
