      "struct": {
        "title": "Solution structure of Ole e 6, an allergen from olive tree pollen"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M406045200"
