      "struct": {
        "title": "High resolution structure of a potent, cyclic protease inhibitor from sunflower seeds"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1006/jmbi.1999.2891"
