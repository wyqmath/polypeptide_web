      "struct": {
        "title": "Solution structure of the folded domain of intermediate IIIb of Tick Carboxypeptidase Inhibitor"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M803978200"
