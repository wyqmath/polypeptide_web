      "struct": {
        "title": "NMR SOLUTION STRUCTURE OF ALPHA-CONOTOXIN IM1 POINT MUTATION VARIANT R11E"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1006/JMBI.2000.4247"
