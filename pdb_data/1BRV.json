      "struct": {
        "title": "SOLUTION NMR STRUCTURE OF THE IMMUNODOMINANT REGION OF PROTEIN G OF BOVINE RESPIRATORY SYNCYTIAL VIRUS, 48 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi9621627"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
