      "struct": {
        "title": "Solution Structure and Activity Study of Bovicin HJ50, a Particular Type AII Lantibiotic"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1042/BJ20131524"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
