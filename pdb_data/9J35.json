      "struct": {
        "title": "Cryo-EM structure of Arabidopsis CNGC5 in nanodisc"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41477-025-01923-z"
