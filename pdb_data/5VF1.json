      "struct": {
        "title": "X-ray Crystallographic Structure of a Giant Double-Walled Peptide Nanotube Formed by a Macrocyclic Beta-Sheet Containing ABeta16-22"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/jacs.7b03890"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 28598147
        },
        "rcsb_pubmed_central_id": null,
        "rcsb_pubmed_doi": "10.1021/jacs.7b03890",
        "rcsb_pubmed_abstract_text": "This paper describes the supramolecular assembly of a macrocyclic β-sheet containing residues 16-22 of the β-amyloid peptide, Aβ. X-ray crystallography reveals that the macrocyclic β-sheet assembles to form double-walled nanotubes, with an inner diameter of 7 nm and outer diameter of 11 nm. The inner wall is composed of an extended network of hydrogen-bonded dimers. The outer wall is composed of a separate extended network of β-barrel-like tetramers. These large peptide nanotubes pack into a hexagonal lattice that resembles a honeycomb. The complexity and size of the peptide nanotubes rivals some of the largest tubular biomolecular assemblies, such as GroEL and microtubules. These observations demonstrate that small amyloidogenic sequences can be used to build large nanostructures.",
        "rcsb_pubmed_affiliation_info": [
          "Department of Chemistry, University of California, Irvine , Irvine, California 92697-2025, United States."
        ]
      },
