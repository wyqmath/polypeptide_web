      "struct": {
        "title": "Characterization of a Novel Alpha4/6-Conotoxin TxIC from Conus textile that Potently Blocks alpha3beta4 Nicotinic Acetylcholine Receptors"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/jm401254c"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 24200193
        },
        "rcsb_pubmed_central_id": "PMC4033315",
        "rcsb_pubmed_doi": "10.1021/jm401254c",
        "rcsb_pubmed_abstract_text": "The \u03b13\u03b24 nAChRs are implicated in pain sensation in the PNS and addiction to nicotine in the CNS. We identified an \u03b1-4/6-conotoxin (CTx) TxID from Conus textile. The new toxin consists of 15 amino acid residues with two disulfide bonds. TxID was synthesized using solid phase methods, and the synthetic peptide was functionally tested on nAChRs heterologously expressed in Xenopus laevis oocytes. TxID blocked rat \u03b13\u03b24 nAChRs with a 12.5 nM IC50, which places it among the most potent \u03b13\u03b24 nAChR antagonists. TxID also blocked the closely related \u03b16/\u03b13\u03b24 with a 94 nM IC50 but showed little activity on other nAChR subtypes. NMR analysis showed that two major structural isomers exist in solution, one of which adopts a regular \u03b1-CTx fold but with different surface charge distribution to other 4/6 family members. \u03b1-CTx TxID is a novel tool with which to probe the structure and function of \u03b13\u03b24 nAChRs.",
        "rcsb_pubmed_affiliation_info": [
          "Key Laboratory of Tropical Biological Resources, Ministry of Education, Key Lab for Marine Drug of Haikou, Hainan University , Haikou Hainan, 570228, China."
        ]
      },
