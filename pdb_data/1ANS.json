      "struct": {
        "title": "THREE-DIMENSIONAL STRUCTURE IN SOLUTION OF NEUROTOXIN III FROM THE SEA ANEMONE ANEMONIA SULCATA"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi00203a001"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
