      "struct": {
        "title": "Solution NMR structure of recifin, a cysteine-rich tyrosyl-DNA Phosphodiesterase I modulatory peptide from the marine sponge Axinella sp."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
