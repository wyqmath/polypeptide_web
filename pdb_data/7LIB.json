      "struct": {
        "title": "X-ray crystal structure of a cyclic peptide containing beta-2-microglobulin (63-69) and a gamma-methylornithine turn unit"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
