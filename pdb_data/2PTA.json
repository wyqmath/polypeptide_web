      "struct": {
        "title": "PANDINUS TOXIN K-A (PITX-KA) FROM PANDINUS IMPERATOR, NMR, 20 STRUCTURES"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi9628432"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
