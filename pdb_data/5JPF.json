      "struct": {
        "title": "Serine/Threonine phosphatase Z1 (Candida albicans) binds to inhibitor microcystin-LR"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1128/mBio.00872-16"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
