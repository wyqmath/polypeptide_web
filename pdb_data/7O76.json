      "struct": {
        "title": "Reversible supramolecular assembly of the anti-microbial peptide plectasin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41467-022-30462-w"
