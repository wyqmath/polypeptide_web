      "struct": {
        "title": "Racemic structure of the cyclic plant peptide PDP-23"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1039/d1cb00155h"
