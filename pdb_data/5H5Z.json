      "struct": {
        "title": "Crystal structure of bony fish MHC class I, peptide and B2m II"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.isci.2020.101119"
