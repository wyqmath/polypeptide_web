      "struct": {
        "title": "NMR structural determination of viscotoxin A3 from Viscum album L."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1042/0264-6021:3500569"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
