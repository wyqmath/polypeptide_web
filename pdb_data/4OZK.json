      "struct": {
        "title": "Crystal structure of Laterosporulin, a broad spectrum leaderless bacteriocin produced by Brevibacillus laterosporus strain GI-9"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1111/febs.13129"
