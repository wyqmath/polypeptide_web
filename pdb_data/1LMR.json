      "struct": {
        "title": "Solution of ADO1, a Toxin from the Assassin Bugs Agriosphodrus dohrni that Blocks the Voltage Sensitive Calcium Channel L-type"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
