      "struct": {
        "title": "Stability of cyclic beta-hairpins: Asymmetric contibutions from side chains of hydrogen bonded cross-strand residue pair"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/ja028075l"
