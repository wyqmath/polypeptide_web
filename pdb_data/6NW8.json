      "struct": {
        "title": "SOLUTION STRUCTURE OF CN29, A TOXIN FROM CENTRUROIDES NOXIUS SCORPION VENOM"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
