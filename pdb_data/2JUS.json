      "struct": {
        "title": "alpha RgIA, a Novel Conotoxin that Blocks the alpha9-alpha10 nAChR"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.jmb.2008.01.082"
