      "struct": {
        "title": "Structure of a Novel P-Superfamily Spasmodic Conotoxin Reveals an Inhibitory Cystine Knot Motif"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
