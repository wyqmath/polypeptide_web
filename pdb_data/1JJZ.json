      "struct": {
        "title": "REFINED STRUCTURE AND DISULFIDE PAIRING OF THE KALATA B1 PEPTIDE"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1006/abbi.2002.2769"
