      "struct": {
        "title": "Solution structure of SFTI-1, A cyclic trypsin inhibitor from sunflower seeds"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1006/jmbi.2001.4887"
