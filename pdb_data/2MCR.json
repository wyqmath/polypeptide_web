      "struct": {
        "title": "Solution structure of ShK-like immunomodulatory peptide from Brugia malayi (filarial worm)"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1096/fj.14-251967"
