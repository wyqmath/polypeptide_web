      "struct": {
        "title": "NMR STRUCTURE OF PSP1, PLASMATOCYTE-SPREADING PEPTIDE FROM PSEUDOPLUSIA INCLUDENS"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.274.8.4493"
