      "struct": {
        "title": "HAIRPINLESS MUTANT OF OMEGA-ATRACOTOXIN-HV1A"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/jbc.M102199200"
