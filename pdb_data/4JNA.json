      "struct": {
        "title": "Crystal structure of the DepH complex with dimethyl-FK228"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/srep04145"
