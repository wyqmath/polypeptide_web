      "struct": {
        "title": "Crystal structure of the unliganded PDE8A catalytic domain"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/bi801487x"
