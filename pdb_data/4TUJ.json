      "struct": {
        "title": "Crystal structure of monoclonal antibody against neuroblastoma associated antigen."
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1074/mcp.M115.052720"
