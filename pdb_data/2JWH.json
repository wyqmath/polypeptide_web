      "struct": {
        "title": "Structure of a Glycosylphosphatidylinositol-anchored Domain from a Trypanosome Variant Surface Glycoprotein"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
