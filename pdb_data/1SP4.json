      "struct": {
        "title": "Crystal structure of NS-134 in complex with bovine cathepsin B: a two headed epoxysuccinyl inhibitor extends along the whole active site cleft"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1042/BJ20040237"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 15084146
        },
        "rcsb_pubmed_central_id": "PMC1133859",
        "rcsb_pubmed_doi": "10.1042/BJ20040237",
        "rcsb_pubmed_abstract_text": "The crystal structure of the inhibitor NS-134 in complex with bovine cathepsin B reveals that functional groups attached to both sides of the epoxysuccinyl reactive group bind to the part of active-site cleft as predicted. The -Leu-Pro-OH side binds to the primed binding sites interacting with the His110 and His111 residues with its C-terminal carboxy group, whereas the -Leu-Gly-Meu (-Leu-Gly-Gly-OMe) part (Meu, methoxycarbonylmethyl) binds along the non-primed binding sites. Comparison with the propeptide structures of cathepsins revealed that the binding of the latter part is least similar to the procathepsin B structure; this result, together with the two-residue shift in positioning of the Leu-Gly-Gly part, suggests that the propeptide structures of the cognate enzymes may not be the best starting point for the design of reverse binding inhibitors.",
        "rcsb_pubmed_affiliation_info": [
          "Department of Biochemistry and Molecular Biology, Josef Stefan Institute, Jamova 39, SI-1000 Ljubljana, Slovenia."
        ]
      },
