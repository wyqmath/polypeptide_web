      "struct": {
        "title": "High-resolution crystal structure of fluoropropylated cystine knot, binding to alpha-5 beta-6 integrin"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41467-019-11863-w"
