      "struct": {
        "title": "Crystal Structure of Cyclophilin TgCyp23 from Toxoplasma gondii in complex with Cyclosporin A"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1021/acsinfecdis.2c00566"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
          "pubmed_id": 36653744
