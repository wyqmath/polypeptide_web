      "struct": {
        "title": "Crystal structure of the chitin-binding module (CBM18) of a chitinase-like protein from Hevea brasiliensis"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1111/febs.12962"
