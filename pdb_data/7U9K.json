      "struct": {
        "title": "Staphylococcus aureus D-alanine-D-alanine ligase in complex with ATP, D-ala-D-ala, Mg2+ and K+"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/j.bmc.2023.117509"
