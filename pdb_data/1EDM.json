      "struct": {
        "title": "EPIDERMAL GROWTH FACTOR-LIKE DOMAIN FROM HUMAN FACTOR IX"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1016/0092-8674(95)90059-4"
      },
      "pubmed": {
        "rcsb_pubmed_container_identifiers": {
