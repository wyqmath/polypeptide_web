      "struct": {
        "title": "Bacterial cellulose synthase BcsB hexamer"
      },
      "rcsb_ma_qa_metric_global": null,
      "rcsb_primary_citation": {
        "id": "primary",
        "pdbx_database_id_DOI": "10.1038/s41594-021-00569-7"
