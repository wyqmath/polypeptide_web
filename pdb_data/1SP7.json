        "rcsb_pubmed_central_id": null,
        "rcsb_pubmed_doi": "10.1016/j.febslet.2004.05.034",
        "rcsb_pubmed_abstract_text": "A high-precision solution structure of the C-terminal minicollagen cysteine rich domain of Hydra has been determined using modern heteronuclear and weak alignment NMR techniques at natural isotope abundance. The domain consists of only 24 amino acids, six of which are prolines and six are cysteines bonded in disulfide bridges that constrain the structure into a new fold. The redox equilibrium of the structure has been characterized from a titration with glutathione. No local native structures are detectable in the reduced form. Thus, oxidation and folding are tightly coupled.",
        "rcsb_pubmed_affiliation_info": [
          "Division of Structural Biology, Universit\u00e4t Basel, Klingelbergstrasse 70, CH-4056 Basel, Switzerland."
        ]
      },
